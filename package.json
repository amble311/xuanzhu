{
  "name": "xuanzhu",
  "version": "0.1.5",
  "description": "玄猪（XuanZhu）— 专为终端打造的 AI 编码 Agent",
  "keywords": [
    "ai",
    "agent",
    "cli",
    "tui",
    "coding-assistant",
    "llm",
    "terminal"
  ],
  "license": "MIT",
  "author": "amble311",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amble311/xuanzhu.git"
  },
  "homepage": "https://github.com/amble311/xuanzhu#readme",
  "bugs": {
    "url": "https://github.com/amble311/xuanzhu/issues"
  },
  "main": "./dist/cli.js",
  "bin": {
    "xzh": "bin/xzh.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node esbuild.js",
