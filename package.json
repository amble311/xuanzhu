    "clean": "rm -rf dist",
    "prepare": "node esbuild.js --production"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@google/generative-ai": "^0.21.0",
    "openai": "^4.28.0"
  },
  "devDependencies": {
    "@types/node": "^20.2.5",
    "esbuild": "^0.25.8",
    "typescript": "^5.4.3"
