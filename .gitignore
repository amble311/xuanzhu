# ── 依赖 ────────────────────────────────────────────────
node_modules/

# ── 构建产物 ────────────────────────────────────────────
# dist/ 由 esbuild.js 生成，npm publish 时会自动重建（prepare 脚本），无需入库
dist/

# ── 运行时生成的本地数据（重要：不要提交）───────────────
# .xuanzhu/ 是「项目级」的使用数据：项目记忆 + 项目规则，随使用产生，
# 每个用户/每个项目各自不同，且可能包含个人的指令与上下文片段。
.xuanzhu/

# .codebuddy/ 是 AI 助手的工作目录（记忆与历史记录）。
# 它是本地工作资产，不是项目源码 —— 忽略但**不要删除本地文件**。
.codebuddy/

# .officecli/ 是 officecli 技能的本地状态（更新检查时间戳、自动更新开关等），
# 随使用产生，与具体机器绑定。
.officecli/

# ── 临时草稿目录（不入库）─────────────────────────────────
# tmp/ 是一次性脚本与草稿的落脚点。release.sh 用的是 `git add -A`，
# 不忽略就会把这些与发布无关的东西一起提交上去。
tmp/

# ── 项目级 AI 指南（只留本地，不入库、不进 npm 包）──────────
# AGENTS.md 是给 AI 助手看的本项目约定（目录约定、分层、文档同步要求等），
# 属于开发者的本地工作资产，不是要分发的内容。
# release.sh 用的是 `git add -A`，不忽略就会每次发布都把它推上 GitHub。
# npm 侧由 package.json 的 files 白名单拦住（只发 bin / dist / docs / README / LICENSE），
# 这里不必重复排除；本条只管 git。
AGENTS.md

# ── 根目录的 MEMORY.md（本地资产，不入库）──────────────────
# 本项目的记忆在 .xuanzhu/ 下（已忽略）。根目录若出现 MEMORY.md，多半是从别的项目
# 拷来做参考的长期记忆 —— 它属于本地资产，而且往往含数据库口令之类的凭据。
# release.sh 用的是 `git add -A`，不忽略就会被推上公开仓库。
/MEMORY.md

# ── 外部参考源码（只读，不入库）─────────────────────────────
# AutoJs6/ 是 AutoJs6 的 Android 源码，仅作为「连接电脑」协议的参考实现放在这里
# （145 MB，含 gradle/构建产物）。它**不是**本项目的代码，绝不能提交 ——
# release.sh 用的是 `git add -A`，不忽略就会把整个 Android 工程打进去。
# 更稳妥的做法是把它放到仓库之外（例如 ~/object/AutoJs6）。
AutoJs6/

# ── 密钥与凭据（万一被误建在项目内）────────────────────
.env
.env.*
.npmrc
*.pem
*.key
*.p12
*.pfx

# ── 日志与临时文件 ──────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*
*.tsbuildinfo
*.tmp

# ── 编辑器与系统 ────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# ── 打包与备份产物 ──────────────────────────────────────
*.tgz
*.zip

# ── Android 安装包（AutoJs6，用于「服务器模式」推送给手机）──
# 单个 130+ MB，两个 ABI 合计 271 MB —— 绝不能入库，也绝不能进 npm 包。
# xzh 只按「可配置的 APK 目录」查找它们（默认 ~/.xzh/apks/），见 src/device/apk.ts。
*.apk
