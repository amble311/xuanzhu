# ── 依赖 ────────────────────────────────────────────────
node_modules/

# ── 构建产物 ────────────────────────────────────────────
# dist/ 由 esbuild.js 生成，npm publish 时会自动重建（prepare 脚本），无需入库
dist/

# ── 运行时生成的本地数据（重要：不要提交）───────────────
# .xuanzhu/ 是「项目级」的使用数据：项目记忆 + 项目规则，随使用产生，
# 每个用户/每个项目各自不同，且可能包含个人的指令与上下文片段。
.xuanzhu/

# .codebuddy/ 是 AI 助手的工作目录（记忆与历史记录）。
# 它是本地工作资产，不是项目源码 —— 忽略但**不要删除本地文件**。
.codebuddy/

# ── 密钥与凭据（万一被误建在项目内）────────────────────
.env
.env.*
.npmrc
*.pem
*.key
*.p12
*.pfx

# ── 日志与临时文件 ──────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*
*.tsbuildinfo
*.tmp

# ── 编辑器与系统 ────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# ── 打包与备份产物 ──────────────────────────────────────
*.tgz
*.zip
